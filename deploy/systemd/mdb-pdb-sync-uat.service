[Unit]
Description=Aurify Mongo->Postgres sync (UAT)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=mdb-pdb-sync
WorkingDirectory=/opt/mdb_pdb_sync
ExecStart=/opt/mdb_pdb_sync/venv/bin/python uat.py
# PrivateTmp is intentionally left unset: common_sync.py's overlap lock file
# lives in the shared temp dir and must be visible across consecutive runs
# of this timer.
